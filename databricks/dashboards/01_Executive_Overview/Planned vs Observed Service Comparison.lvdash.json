{
  "datasets": [
    {
      "name": "714ca238",
      "displayName": "daily_summary",
      "queryLines": [
        "SELECT\r\n",
        "  analysis_date,\r\n",
        "  planned_lines_count,\r\n",
        "  observed_lines_count,\r\n",
        "  planned_lines_observed_count,\r\n",
        "  planned_lines_not_observed_count,\r\n",
        "  observed_lines_not_in_gtfs_count,\r\n",
        "  planned_lines_observed_pct\r\n",
        "FROM main.gold.gold_planned_vs_observed_daily\r\n",
        "ORDER BY analysis_date DESC"
      ]
    },
    {
      "name": "aac58137",
      "displayName": "line_status_detail",
      "queryLines": [
        "SELECT\r\n",
        "  analysis_date,\r\n",
        "  line_code,\r\n",
        "  planned_route_id,\r\n",
        "  observed_line_sign,\r\n",
        "  match_status,\r\n",
        "  observed_events_count,\r\n",
        "  observed_vehicles_count\r\n",
        "FROM main.gold.gold_planned_vs_observed_line_status\r\n",
        "ORDER BY analysis_date DESC, line_code"
      ]
    }
  ],
