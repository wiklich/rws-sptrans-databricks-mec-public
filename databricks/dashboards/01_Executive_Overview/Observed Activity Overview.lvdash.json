{
  "datasets": [
    {
      "name": "d1a7c3e4",
      "displayName": "daily_summary_selected_date",
      "queryLines": [
        "SELECT\r\n",
        "  analysis_date,\r\n",
        "  observed_position_records_count,\r\n",
        "  distinct_observed_vehicles_count,\r\n",
        "  distinct_observed_lines_count,\r\n",
        "  distinct_observed_hours_count,\r\n",
        "  distinct_observed_minutes_count,\r\n",
        "  min_captured_at_local,\r\n",
        "  max_captured_at_local\r\n",
        "FROM main.gold.gold_observed_daily_activity\r\n",
        "WHERE analysis_date = :p_analysis_date"
      ],
      "parameters": [
        {
          "displayName": "p_analysis_date",
          "keyword": "p_analysis_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2026-03-18T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "e5b9f1a2",
      "displayName": "daily_trend",
      "queryLines": [
        "SELECT\r\n",
        "  analysis_date,\r\n",
        "  observed_position_records_count,\r\n",
        "  distinct_observed_vehicles_count,\r\n",
        "  distinct_observed_lines_count,\r\n",
        "  distinct_observed_hours_count,\r\n",
        "  distinct_observed_minutes_count\r\n",
        "FROM main.gold.gold_observed_daily_activity\r\n",
        "ORDER BY analysis_date"
      ]
    },
    {
      "name": "f6c2d8b7",
      "displayName": "hourly_activity_selected_date",
      "queryLines": [
        "SELECT\r\n",
        "  analysis_date,\r\n",
        "  analysis_hour_local,\r\n",
        "  observed_position_records_count,\r\n",
        "  distinct_observed_vehicles_count,\r\n",
        "  distinct_observed_lines_count,\r\n",
        "  distinct_minutes_with_data,\r\n",
        "  min_captured_at_local,\r\n",
        "  max_captured_at_local\r\n",
        "FROM main.gold.gold_observed_intraday_hourly_activity\r\n",
        "WHERE analysis_date = :p_analysis_date\r\n",
        "ORDER BY analysis_hour_local"
      ],
      "parameters": [
        {
          "displayName": "p_analysis_date",
          "keyword": "p_analysis_date",
