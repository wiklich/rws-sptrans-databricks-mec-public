    {
      "name": "c3d4e5f6",
      "displayName": "top_lines_missed_service",
      "queryLines": [
        "SELECT\r\n",
        "  line_sign,\r\n",
        "  SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END) AS planned_service_hours,\r\n",
        "  SUM(CASE WHEN missed_service_flag THEN 1 ELSE 0 END) AS missed_service_windows,\r\n",
        "  CASE\r\n",
        "    WHEN SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END) = 0 THEN NULL\r\n",
        "    ELSE SUM(CASE WHEN missed_service_flag THEN 1 ELSE 0 END) * 1.0\r\n",
        "         / SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END)\r\n",
        "  END AS missed_service_rate\r\n",
        "FROM main.gold.gold_planned_vs_observed_service_adherence_hourly\r\n",
        "WHERE (\r\n",
        "    :p_service_date_range.min IS NULL\r\n",
        "    OR :p_service_date_range.max IS NULL\r\n",
        "    OR service_date BETWEEN CAST(:p_service_date_range.min AS DATE)\r\n",
        "                        AND CAST(:p_service_date_range.max AS DATE)\r\n",
        "  )\r\n",
        "  AND (\r\n",
        "    :p_gtfs_direction_id = 'ALL'\r\n",
        "    OR CAST(gtfs_direction_id AS STRING) = :p_gtfs_direction_id\r\n",
        "  )\r\n",
        "GROUP BY line_sign\r\n",
        "HAVING SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END) > 0\r\n",
        "ORDER BY missed_service_rate DESC, missed_service_windows DESC, line_sign ASC\r\n",
        "LIMIT 15"
      ],
      "parameters": [
        {
          "displayName": "Service Date Range",
          "keyword": "p_service_date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "2026-03-18T00:00:00.000"
              },
              "max": {
                "value": "2026-03-18T00:00:00.000"
              }
            }
          }
        },
        {
          "displayName": "GTFS Direction",
          "keyword": "p_gtfs_direction_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "d4e5f607",
      "displayName": "top_lines_headway_deviation",
      "queryLines": [
        "SELECT\r\n",
        "  line_sign,\r\n",
        "  AVG(CASE WHEN headway_deviation_minutes > 0 THEN headway_deviation_minutes END) AS avg_positive_headway_deviation_minutes,\r\n",
        "  AVG(headway_deviation_minutes) AS avg_headway_deviation_minutes,\r\n",
        "  AVG(headway_deviation_pct) AS avg_headway_deviation_pct\r\n",
        "FROM main.gold.gold_planned_vs_observed_service_adherence_hourly\r\n",
        "WHERE (\r\n",
        "    :p_service_date_range.min IS NULL\r\n",
        "    OR :p_service_date_range.max IS NULL\r\n",
        "    OR service_date BETWEEN CAST(:p_service_date_range.min AS DATE)\r\n",
        "                        AND CAST(:p_service_date_range.max AS DATE)\r\n",
        "  )\r\n",
        "  AND (\r\n",
        "    :p_gtfs_direction_id = 'ALL'\r\n",
        "    OR CAST(gtfs_direction_id AS STRING) = :p_gtfs_direction_id\r\n",
        "  )\r\n",
        "GROUP BY line_sign\r\n",
        "HAVING AVG(CASE WHEN headway_deviation_minutes > 0 THEN headway_deviation_minutes END) IS NOT NULL\r\n",
        "ORDER BY avg_positive_headway_deviation_minutes DESC, line_sign ASC\r\n",
        "LIMIT 15"
      ],
      "parameters": [
        {
          "displayName": "Service Date Range",
          "keyword": "p_service_date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "2026-03-18T00:00:00.000"
              },
              "max": {
                "value": "2026-03-18T00:00:00.000"
              }
            }
          }
        },
        {
          "displayName": "GTFS Direction",
          "keyword": "p_gtfs_direction_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "e5f60718",
      "displayName": "direction_options",
      "queryLines": [
        "SELECT\r\n",
        "  gtfs_direction_id\r\n",
        "FROM (\r\n",
        "  SELECT 'ALL' AS gtfs_direction_id, 0 AS sort_order\r\n",
        "  UNION ALL\r\n",
        "  SELECT DISTINCT CAST(gtfs_direction_id AS STRING) AS gtfs_direction_id, 1 AS sort_order\r\n",
        "  FROM main.gold.gold_planned_vs_observed_service_adherence_hourly\r\n",
        "  WHERE gtfs_direction_id IS NOT NULL\r\n",
        ") options\r\n",
        "ORDER BY sort_order, gtfs_direction_id"
      ]
    }
  ],
