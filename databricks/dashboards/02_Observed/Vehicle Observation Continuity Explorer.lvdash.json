{
  "datasets": [
    {
      "name": "a91b02c3",
      "displayName": "vehicle_continuity_summary",
      "queryLines": [
        "SELECT\r\n",
        "  MAX(record_created_at) AS latest_refresh_at,\r\n",
        "  COUNT(*) AS vehicles_count,\r\n",
        "  SUM(observations_count) AS total_observations_count,\r\n",
        "  SUM(measured_gaps_count) AS total_measured_gaps_count,\r\n",
        "  AVG(continuity_support_ratio) AS avg_continuity_support_ratio,\r\n",
        "  CASE\r\n",
        "    WHEN SUM(measured_gaps_count) = 0 THEN NULL\r\n",
        "    ELSE SUM(COALESCE(avg_gap_seconds, 0.0) * measured_gaps_count) * 1.0 / SUM(measured_gaps_count)\r\n",
        "  END AS weighted_avg_gap_seconds,\r\n",
        "  AVG(max_gap_seconds) AS avg_max_gap_seconds,\r\n",
        "  SUM(large_gaps_count) AS total_large_gaps_count\r\n",
        "FROM main.gold.gold_vehicle_observation_continuity\r\n",
        "WHERE (\r\n",
        "    :p_vehicle_prefix = 'ALL'\r\n",
        "    OR CAST(vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "  )\r\n"
      ],
      "parameters": [
        {
          "displayName": "Vehicle Prefix",
          "keyword": "p_vehicle_prefix",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "b02c13d4",
      "displayName": "most_fragmented_vehicles",
      "queryLines": [
        "SELECT\r\n",
        "  CAST(vehicle_prefix AS STRING) AS vehicle_prefix,\r\n",
        "  observations_count,\r\n",
        "  measured_gaps_count,\r\n",
        "  continuity_support_ratio,\r\n",
        "  avg_gap_seconds,\r\n",
        "  max_gap_seconds,\r\n",
        "  large_gaps_count,\r\n",
        "  distinct_minutes_with_data,\r\n",
        "  observed_span_seconds\r\n",
        "FROM main.gold.gold_vehicle_observation_continuity\r\n",
        "WHERE (\r\n",
        "    :p_vehicle_prefix = 'ALL'\r\n",
        "    OR CAST(vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "  )\r\n",
        "ORDER BY continuity_support_ratio ASC, large_gaps_count DESC, vehicle_prefix ASC\r\n",
        "LIMIT 15\r\n"
      ],
      "parameters": [
        {
          "displayName": "Vehicle Prefix",
          "keyword": "p_vehicle_prefix",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    },
