{
  "datasets": [
    {
      "name": "1f2a3b4c",
      "displayName": "system_wide_summary",
      "queryLines": [
        "SELECT\r\n",
        "  aggregation_scope,\r\n",
        "  vehicles_count,\r\n",
        "  total_observations_count,\r\n",
        "  total_measured_intervals_count,\r\n",
        "  system_avg_update_interval_seconds,\r\n",
        "  system_min_update_interval_seconds,\r\n",
        "  system_max_update_interval_seconds,\r\n",
        "  system_avg_vehicle_stddev_interval_seconds,\r\n",
        "  total_distinct_minutes_with_data,\r\n",
        "  avg_continuity_support_ratio,\r\n",
        "  total_large_gaps_count,\r\n",
        "  record_created_at\r\n",
        "FROM main.gold.gold_system_wide_update_behavior\r\n",
        "ORDER BY aggregation_scope"
      ]
    },
    {
      "name": "2a3b4c5d",
      "displayName": "system_wide_metric_profile",
      "queryLines": [
        "SELECT\r\n",
        "  aggregation_scope,\r\n",
        "  'Vehicles Count' AS metric_name,\r\n",
        "  CAST(vehicles_count AS DOUBLE) AS metric_value,\r\n",
        "  'count' AS metric_group\r\n",
        "FROM main.gold.gold_system_wide_update_behavior\r\n",
        "UNION ALL\r\n",
        "SELECT\r\n",
        "  aggregation_scope,\r\n",
        "  'Total Observations Count' AS metric_name,\r\n",
        "  CAST(total_observations_count AS DOUBLE) AS metric_value,\r\n",
        "  'count' AS metric_group\r\n",
        "FROM main.gold.gold_system_wide_update_behavior\r\n",
        "UNION ALL\r\n",
        "SELECT\r\n",
        "  aggregation_scope,\r\n",
        "  'Total Measured Intervals Count' AS metric_name,\r\n",
        "  CAST(total_measured_intervals_count AS DOUBLE) AS metric_value,\r\n",
        "  'count' AS metric_group\r\n",
        "FROM main.gold.gold_system_wide_update_behavior\r\n",
        "UNION ALL\r\n",
        "SELECT\r\n",
        "  aggregation_scope,\r\n",
        "  'Total Distinct Minutes With Data' AS metric_name,\r\n",
        "  CAST(total_distinct_minutes_with_data AS DOUBLE) AS metric_value,\r\n",
        "  'count' AS metric_group\r\n",
        "FROM main.gold.gold_system_wide_update_behavior\r\n",
        "UNION ALL\r\n",
        "SELECT\r\n",
        "  aggregation_scope,\r\n",
        "  'System Avg Update Interval (Sec)' AS metric_name,\r\n",
        "  CAST(system_avg_update_interval_seconds AS DOUBLE) AS metric_value,\r\n",
        "  'interval' AS metric_group\r\n",
        "FROM main.gold.gold_system_wide_update_behavior\r\n",
        "UNION ALL\r\n",
        "SELECT\r\n",
        "  aggregation_scope,\r\n",
        "  'System Min Update Interval (Sec)' AS metric_name,\r\n",
        "  CAST(system_min_update_interval_seconds AS DOUBLE) AS metric_value,\r\n",
        "  'interval' AS metric_group\r\n",
        "FROM main.gold.gold_system_wide_update_behavior\r\n",
        "UNION ALL\r\n",
        "SELECT\r\n",
        "  aggregation_scope,\r\n",
        "  'System Max Update Interval (Sec)' AS metric_name,\r\n",
        "  CAST(system_max_update_interval_seconds AS DOUBLE) AS metric_value,\r\n",
        "  'interval' AS metric_group\r\n",
        "FROM main.gold.gold_system_wide_update_behavior\r\n",
        "UNION ALL\r\n",
        "SELECT\r\n",
        "  aggregation_scope,\r\n",
        "  'Avg Vehicle Stddev Interval (Sec)' AS metric_name,\r\n",
        "  CAST(system_avg_vehicle_stddev_interval_seconds AS DOUBLE) AS metric_value,\r\n",
        "  'interval' AS metric_group\r\n",
        "FROM main.gold.gold_system_wide_update_behavior\r\n",
        "UNION ALL\r\n",
        "SELECT\r\n",
        "  aggregation_scope,\r\n",
        "  'Avg Continuity Support Ratio' AS metric_name,\r\n",
        "  CAST(avg_continuity_support_ratio AS DOUBLE) AS metric_value,\r\n",
        "  'ratio' AS metric_group\r\n",
        "FROM main.gold.gold_system_wide_update_behavior\r\n",
        "UNION ALL\r\n",
        "SELECT\r\n",
        "  aggregation_scope,\r\n",
        "  'Total Large Gaps Count' AS metric_name,\r\n",
        "  CAST(total_large_gaps_count AS DOUBLE) AS metric_value,\r\n",
        "  'count' AS metric_group\r\n",
        "FROM main.gold.gold_system_wide_update_behavior\r\n",
        "ORDER BY aggregation_scope, metric_group, metric_name"
      ]
    },
    {
      "name": "3b4c5d6e",
      "displayName": "aggregation_scope_options",
      "queryLines": [
        "SELECT\r\n",
        "  aggregation_scope\r\n",
        "FROM main.gold.gold_system_wide_update_behavior\r\n",
        "WHERE aggregation_scope IS NOT NULL\r\n",
        "ORDER BY aggregation_scope"
      ]
    }
  ],
