      "displayName": "Global Filters",
      "layout": [
        {
          "widget": {
            "name": "aggregation-scope",
            "queries": [
              {
                "name": "dashboards/system_wide_update_behavior_overview/datasets/aggregation_scope_options_aggregation_scope",
                "query": {
                  "datasetName": "3b4c5d6e",
                  "fields": [
                    {
                      "name": "aggregation_scope",
                      "expression": "`aggregation_scope`"
                    },
                    {
                      "name": "aggregation_scope_associativity",
                      "expression": "COUNT_IF(`associative_filter_predicate_group`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": {
                "showTitle": true,
                "title": "Aggregation Scope"
              },
              "widgetType": "filter-single-select",
              "encodings": {
