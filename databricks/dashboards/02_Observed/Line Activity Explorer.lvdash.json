{
  "datasets": [
    {
      "name": "1a2b3c4d",
      "displayName": "line_options_by_date",
      "queryLines": [
        "SELECT DISTINCT\r\n",
        "  line_sign\r\n",
        "FROM main.gold.gold_vehicle_observed_spatial_traces\r\n",
        "WHERE analysis_date = :p_analysis_date\r\n",
        "  AND line_sign IS NOT NULL\r\n",
        "  AND TRIM(line_sign) <> ''\r\n",
        "ORDER BY line_sign"
      ],
      "parameters": [
        {
          "displayName": "p_analysis_date",
          "keyword": "p_analysis_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2026-03-18T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2b3c4d5e",
      "displayName": "line_trace_points_base",
      "queryLines": [
        "SELECT\r\n",
        "  analysis_date,\r\n",
        "  vehicle_prefix,\r\n",
        "  trace_sequence,\r\n",
        "  captured_at_local,\r\n",
        "  latitude,\r\n",
        "  longitude,\r\n",
        "  line_sign,\r\n",
        "  direction,\r\n",
        "  CASE\r\n",
        "    WHEN direction = '1' OR direction = 1 THEN 'Main to Secondary'\r\n",
        "    WHEN direction = '2' OR direction = 2 THEN 'Secondary to Main'\r\n",
        "    ELSE CAST(direction AS STRING)\r\n",
        "  END AS direction_description,\r\n",
        "  previous_captured_at_local,\r\n",
        "  previous_latitude,\r\n",
        "  previous_longitude,\r\n",
        "  CASE\r\n",
        "    WHEN previous_captured_at_local IS NULL THEN NULL\r\n",
        "    ELSE unix_timestamp(captured_at_local) - unix_timestamp(previous_captured_at_local)\r\n",
        "  END AS time_since_previous_seconds\r\n",
        "FROM main.gold.gold_vehicle_observed_spatial_traces\r\n",
        "WHERE analysis_date = :p_analysis_date\r\n",
        "  AND line_sign = :p_line_sign\r\n",
        "  AND (\r\n",
        "    :p_captured_at_range.min IS NULL OR :p_captured_at_range.max IS NULL\r\n",
        "    OR captured_at_local BETWEEN :p_captured_at_range.min AND :p_captured_at_range.max\r\n",
        "  )\r\n",
        "ORDER BY vehicle_prefix, trace_sequence"
      ],
      "parameters": [
        {
          "displayName": "p_analysis_date",
          "keyword": "p_analysis_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2026-03-18T00:00:00.000"
                }
              ]
            }
          }
        },
        {
          "displayName": "p_line_sign",
          "keyword": "p_line_sign",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "N106-11"
                }
              ]
            }
          }
        },
        {
          "displayName": "p_captured_at_range",
          "keyword": "p_captured_at_range",
          "dataType": "DATETIME",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATETIME"
            }
          }
        }
      ]
    },
    {
      "name": "3c4d5e6f",
      "displayName": "line_summary",
      "queryLines": [
        "WITH base AS (\r\n",
        "  SELECT\r\n",
        "    analysis_date,\r\n",
        "    vehicle_prefix,\r\n",
        "    captured_at_local,\r\n",
        "    CASE\r\n",
        "      WHEN previous_captured_at_local IS NULL THEN NULL\r\n",
        "      ELSE unix_timestamp(captured_at_local) - unix_timestamp(previous_captured_at_local)\r\n",
        "    END AS time_since_previous_seconds\r\n",
        "  FROM main.gold.gold_vehicle_observed_spatial_traces\r\n",
        "  WHERE analysis_date = :p_analysis_date\r\n",
        "    AND line_sign = :p_line_sign\r\n",
        "    AND (\r\n",
        "      :p_captured_at_range.min IS NULL OR :p_captured_at_range.max IS NULL\r\n",
        "      OR captured_at_local BETWEEN :p_captured_at_range.min AND :p_captured_at_range.max\r\n",
        "    )\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  analysis_date,\r\n",
        "  COUNT(*) AS observed_trace_points_count,\r\n",
        "  COUNT(DISTINCT vehicle_prefix) AS distinct_observed_vehicles_count,\r\n",
        "  MIN(captured_at_local) AS first_captured_at_local,\r\n",
        "  MAX(captured_at_local) AS last_captured_at_local,\r\n",
        "  AVG(time_since_previous_seconds) AS avg_gap_seconds,\r\n",
        "  MAX(time_since_previous_seconds) AS max_gap_seconds\r\n",
        "FROM base\r\n",
        "GROUP BY analysis_date"
      ],
      "parameters": [
        {
          "displayName": "p_analysis_date",
          "keyword": "p_analysis_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2026-03-18T00:00:00.000"
                }
              ]
            }
          }
        },
        {
          "displayName": "p_line_sign",
          "keyword": "p_line_sign",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "N106-11"
                }
              ]
            }
          }
        },
        {
          "displayName": "p_captured_at_range",
          "keyword": "p_captured_at_range",
          "dataType": "DATETIME",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATETIME"
            }
          }
        }
      ]
    },
    {
      "name": "4d5e6f70",
      "displayName": "line_hourly_activity",
      "queryLines": [
        "SELECT\r\n",
        "  analysis_date,\r\n",
        "  hour(captured_at_local) AS analysis_hour_local,\r\n",
        "  COUNT(*) AS observed_trace_points_count,\r\n",
        "  COUNT(DISTINCT vehicle_prefix) AS distinct_observed_vehicles_count\r\n",
        "FROM main.gold.gold_vehicle_observed_spatial_traces\r\n",
        "WHERE analysis_date = :p_analysis_date\r\n",
        "  AND line_sign = :p_line_sign\r\n",
        "  AND (\r\n",
        "    :p_captured_at_range.min IS NULL OR :p_captured_at_range.max IS NULL\r\n",
        "    OR captured_at_local BETWEEN :p_captured_at_range.min AND :p_captured_at_range.max\r\n",
        "  )\r\n",
        "GROUP BY analysis_date, hour(captured_at_local)\r\n",
        "ORDER BY analysis_hour_local"
      ],
      "parameters": [
        {
          "displayName": "p_analysis_date",
          "keyword": "p_analysis_date",
