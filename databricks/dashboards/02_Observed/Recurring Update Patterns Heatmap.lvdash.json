{
  "datasets": [
    {
      "name": "11aa22bb",
      "displayName": "recurring_patterns_summary",
      "queryLines": [
        "SELECT\r\n",
        "  MAX(record_created_at) AS latest_refresh_at,\r\n",
        "  COUNT(*) AS pattern_buckets_count,\r\n",
        "  SUM(observations_count) AS total_observations_count,\r\n",
        "  SUM(measured_intervals_count) AS total_measured_intervals_count,\r\n",
        "  CASE\r\n",
        "    WHEN SUM(measured_intervals_count) = 0 THEN NULL\r\n",
        "    ELSE SUM(COALESCE(avg_update_interval_seconds, 0.0) * measured_intervals_count) * 1.0 / SUM(measured_intervals_count)\r\n",
        "  END AS weighted_avg_update_interval_seconds,\r\n",
        "  AVG(distinct_vehicles_count) AS avg_distinct_vehicles_per_bucket,\r\n",
        "  AVG(distinct_dates_count) AS avg_distinct_dates_per_bucket\r\n",
        "FROM main.gold.gold_recurring_update_patterns\r\n"
      ]
    },
    {
      "name": "22bb33cc",
      "displayName": "recurring_patterns_bucket_detail",
      "queryLines": [
        "SELECT\r\n",
        "  day_of_week,\r\n",
        "  CASE day_of_week\r\n",
        "    WHEN 1 THEN 'Sunday'\r\n",
        "    WHEN 2 THEN 'Monday'\r\n",
        "    WHEN 3 THEN 'Tuesday'\r\n",
        "    WHEN 4 THEN 'Wednesday'\r\n",
        "    WHEN 5 THEN 'Thursday'\r\n",
        "    WHEN 6 THEN 'Friday'\r\n",
        "    WHEN 7 THEN 'Saturday'\r\n",
        "  END AS day_of_week_label,\r\n",
        "  hour_of_day,\r\n",
        "  observations_count,\r\n",
        "  measured_intervals_count,\r\n",
        "  avg_update_interval_seconds,\r\n",
        "  min_update_interval_seconds,\r\n",
        "  max_update_interval_seconds,\r\n",
        "  stddev_update_interval_seconds,\r\n",
        "  distinct_vehicles_count,\r\n",
        "  distinct_dates_count,\r\n",
        "  avg_intervals_per_vehicle,\r\n",
        "  avg_intervals_per_date,\r\n",
        "  record_created_at\r\n",
        "FROM main.gold.gold_recurring_update_patterns\r\n",
        "ORDER BY day_of_week ASC, hour_of_day ASC\r\n"
      ]
    },
    {
      "name": "33cc44dd",
      "displayName": "hourly_interval_profile",
      "queryLines": [
        "SELECT\r\n",
        "  hour_of_day,\r\n",
        "  SUM(observations_count) AS total_observations_count,\r\n",
        "  SUM(measured_intervals_count) AS total_measured_intervals_count,\r\n",
        "  CASE\r\n",
        "    WHEN SUM(measured_intervals_count) = 0 THEN NULL\r\n",
        "    ELSE SUM(COALESCE(avg_update_interval_seconds, 0.0) * measured_intervals_count) * 1.0 / SUM(measured_intervals_count)\r\n",
        "  END AS weighted_avg_update_interval_seconds,\r\n",
        "  AVG(distinct_vehicles_count) AS avg_distinct_vehicles_count,\r\n",
        "  AVG(distinct_dates_count) AS avg_distinct_dates_count\r\n",
        "FROM main.gold.gold_recurring_update_patterns\r\n",
        "GROUP BY hour_of_day\r\n",
        "ORDER BY hour_of_day ASC\r\n"
      ]
    },
    {
      "name": "44dd55ee",
      "displayName": "day_of_week_interval_profile",
      "queryLines": [
        "SELECT\r\n",
        "  day_of_week,\r\n",
        "  CASE day_of_week\r\n",
        "    WHEN 1 THEN 'Sunday'\r\n",
        "    WHEN 2 THEN 'Monday'\r\n",
        "    WHEN 3 THEN 'Tuesday'\r\n",
        "    WHEN 4 THEN 'Wednesday'\r\n",
        "    WHEN 5 THEN 'Thursday'\r\n",
        "    WHEN 6 THEN 'Friday'\r\n",
        "    WHEN 7 THEN 'Saturday'\r\n",
        "  END AS day_of_week_label,\r\n",
        "  SUM(observations_count) AS total_observations_count,\r\n",
        "  SUM(measured_intervals_count) AS total_measured_intervals_count,\r\n",
        "  CASE\r\n",
        "    WHEN SUM(measured_intervals_count) = 0 THEN NULL\r\n",
        "    ELSE SUM(COALESCE(avg_update_interval_seconds, 0.0) * measured_intervals_count) * 1.0 / SUM(measured_intervals_count)\r\n",
        "  END AS weighted_avg_update_interval_seconds,\r\n",
        "  AVG(distinct_vehicles_count) AS avg_distinct_vehicles_count,\r\n",
        "  AVG(distinct_dates_count) AS avg_distinct_dates_count\r\n",
        "FROM main.gold.gold_recurring_update_patterns\r\n",
        "GROUP BY day_of_week\r\n",
        "ORDER BY day_of_week ASC\r\n"
      ]
    }
