{
  "datasets": [
    {
      "name": "04742bdb",
      "displayName": "vehicle_options_by_date",
      "queryLines": [
        "SELECT DISTINCT\r\n",
        "  vehicle_prefix\r\n",
        "FROM main.gold.gold_vehicle_observed_spatial_traces\r\n",
        "WHERE analysis_date = :p_analysis_date\r\n",
        "ORDER BY vehicle_prefix"
      ],
      "parameters": [
        {
          "displayName": "p_analysis_date",
          "keyword": "p_analysis_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2026-03-18T00:00:00.000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "d689ae2b",
      "displayName": "trace_points_base",
      "queryLines": [
        "SELECT\r\n",
        "  analysis_date,\r\n",
        "  vehicle_prefix,\r\n",
        "  trace_sequence,\r\n",
        "  captured_at_local,\r\n",
        "  latitude,\r\n",
        "  longitude,\r\n",
        "  line_sign,\r\n",
        "  direction,\r\n",
        "  CASE\r\n",
        "    WHEN direction = 1 THEN 'Main to Secondary'\r\n",
        "    WHEN direction = 2 THEN 'Secondary to Main'\r\n",
        "    ELSE NULL\r\n",
        "  END AS direction_description,\r\n",
        "  previous_captured_at_local,\r\n",
        "  previous_latitude,\r\n",
        "  previous_longitude,\r\n",
        "  CASE\r\n",
        "    WHEN previous_captured_at_local IS NULL THEN NULL\r\n",
        "    ELSE unix_timestamp(captured_at_local) - unix_timestamp(previous_captured_at_local)\r\n",
        "  END AS time_since_previous_seconds\r\n",
        "FROM main.gold.gold_vehicle_observed_spatial_traces\r\n",
        "WHERE vehicle_prefix = :p_vehicle_prefix\r\n",
        "  AND (\r\n",
        "    :p_analysis_date IS NOT NULL\r\n",
        "    OR :p_captured_at_range IS NOT NULL\r\n",
        "  )\r\n",
        "  AND (\r\n",
        "    :p_analysis_date IS NULL\r\n",
        "    OR analysis_date = :p_analysis_date\r\n",
        "  )\r\n",
        "  AND (\r\n",
        "    :p_captured_at_range.min IS NULL OR :p_captured_at_range.max IS NULL\r\n",
        "    OR captured_at_local BETWEEN :p_captured_at_range.min AND :p_captured_at_range.max\r\n",
        "  )\r\n",
        "ORDER BY trace_sequence"
      ],
      "parameters": [
        {
          "displayName": "p_analysis_date",
          "keyword": "p_analysis_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2026-03-18T00:00:00.000"
                }
              ]
            }
          }
        },
        {
          "displayName": "p_vehicle_prefix",
          "keyword": "p_vehicle_prefix",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "16463"
                }
              ]
            }
          }
        },
        {
          "displayName": "p_captured_at_range",
          "keyword": "p_captured_at_range",
          "dataType": "DATETIME",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATETIME"
            }
          }
        }
      ]
    },
    {
      "name": "edc7bd55",
      "displayName": "trace_summary",
      "queryLines": [
        "WITH base AS (\r\n",
        "  SELECT\r\n",
        "    analysis_date,\r\n",
        "    vehicle_prefix,\r\n",
        "    trace_sequence,\r\n",
        "    captured_at_local,\r\n",
        "    line_sign,\r\n",
        "    direction,\r\n",
        "    CASE\r\n",
        "      WHEN previous_captured_at_local IS NULL THEN NULL\r\n",
        "      ELSE unix_timestamp(captured_at_local) - unix_timestamp(previous_captured_at_local)\r\n",
        "    END AS time_since_previous_seconds\r\n",
        "  FROM main.gold.gold_vehicle_observed_spatial_traces\r\n",
        "  WHERE analysis_date = :p_analysis_date\r\n",
        "    AND vehicle_prefix = :p_vehicle_prefix\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  analysis_date,\r\n",
        "  vehicle_prefix,\r\n",
        "  COUNT(*) AS trace_points_count,\r\n",
        "  MIN(captured_at_local) AS first_captured_at_local,\r\n",
        "  MAX(captured_at_local) AS last_captured_at_local,\r\n",
        "  MIN(time_since_previous_seconds) AS min_gap_seconds,\r\n",
        "  AVG(time_since_previous_seconds) AS avg_gap_seconds,\r\n",
        "  MAX(time_since_previous_seconds) AS max_gap_seconds,\r\n",
        "  SUM(\r\n",
        "    CASE\r\n",
        "      WHEN time_since_previous_seconds IS NOT NULL\r\n",
        "       AND time_since_previous_seconds > 300 THEN 1\r\n",
        "      ELSE 0\r\n",
        "    END\r\n",
        "  ) AS large_gaps_count\r\n",
        "FROM base\r\n",
        "GROUP BY analysis_date, vehicle_prefix"
      ],
      "parameters": [
        {
          "displayName": "p_analysis_date",
          "keyword": "p_analysis_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2026-03-18T00:00:00.000"
                }
              ]
            }
          }
        },
        {
          "displayName": "p_vehicle_prefix",
          "keyword": "p_vehicle_prefix",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "121"
                }
              ]
            }
          }
        }
      ]
    }
  ],
