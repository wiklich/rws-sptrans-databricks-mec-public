        "  md.missing_dates_within_span_count,\r\n",
        "  md.date_presence_ratio,\r\n",
        "  md.total_observations_count,\r\n",
        "  md.max_consecutive_missing_dates_within_span\r\n",
        "FROM main.gold.gold_vehicle_observation_continuity oc\r\n",
