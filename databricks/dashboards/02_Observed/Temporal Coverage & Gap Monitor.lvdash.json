{
  "datasets": [
    {
      "name": "a501b602",
      "displayName": "temporal_gap_summary",
      "queryLines": [
        "WITH base AS (\r\n",
        "  SELECT\r\n",
        "    oc.vehicle_prefix,\r\n",
        "    oc.observations_count,\r\n",
        "    oc.measured_gaps_count,\r\n",
        "    oc.observed_span_seconds,\r\n",
        "    oc.distinct_minutes_with_data,\r\n",
        "    oc.distinct_hours_with_data,\r\n",
        "    oc.avg_gap_seconds,\r\n",
        "    oc.max_gap_seconds,\r\n",
        "    oc.large_gaps_count,\r\n",
        "    oc.continuity_support_ratio,\r\n",
        "    md.observed_dates_count,\r\n",
        "    md.observed_date_span_days,\r\n",
        "    md.missing_dates_within_span_count,\r\n",
        "    md.date_presence_ratio,\r\n",
        "    md.total_observations_count,\r\n",
        "    md.max_consecutive_observed_dates,\r\n",
        "    md.max_consecutive_missing_dates_within_span\r\n",
        "  FROM main.gold.gold_vehicle_observation_continuity oc\r\n",
        "  INNER JOIN main.gold.gold_vehicle_multi_day_continuity md\r\n",
        "    ON oc.vehicle_prefix = md.vehicle_prefix\r\n",
        "  WHERE (\r\n",
        "      :p_vehicle_prefix = 'ALL'\r\n",
        "      OR CAST(oc.vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "    )\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  COUNT(*) AS vehicles_count,\r\n",
        "  SUM(large_gaps_count) AS total_large_gaps_count,\r\n",
        "  AVG(max_gap_seconds) AS avg_max_gap_seconds,\r\n",
        "  AVG(continuity_support_ratio) AS avg_continuity_support_ratio,\r\n",
        "  AVG(date_presence_ratio) AS avg_date_presence_ratio,\r\n",
        "  AVG(missing_dates_within_span_count) AS avg_missing_dates_within_span_count,\r\n",
        "  AVG(max_consecutive_missing_dates_within_span) AS avg_max_consecutive_missing_dates_within_span\r\n",
        "FROM base\r\n"
      ],
      "parameters": [
        {
          "displayName": "Vehicle Prefix",
          "keyword": "p_vehicle_prefix",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "b602c703",
      "displayName": "top_large_gaps_vehicles",
      "queryLines": [
        "SELECT\r\n",
        "  CAST(vehicle_prefix AS STRING) AS vehicle_prefix,\r\n",
        "  observations_count,\r\n",
        "  measured_gaps_count,\r\n",
        "  avg_gap_seconds,\r\n",
        "  max_gap_seconds,\r\n",
        "  large_gaps_count,\r\n",
        "  continuity_support_ratio,\r\n",
        "  observed_span_seconds,\r\n",
        "  distinct_minutes_with_data\r\n",
        "FROM main.gold.gold_vehicle_observation_continuity\r\n",
        "WHERE (\r\n",
        "    :p_vehicle_prefix = 'ALL'\r\n",
        "    OR CAST(vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "  )\r\n",
        "ORDER BY large_gaps_count DESC, max_gap_seconds DESC, vehicle_prefix ASC\r\n",
        "LIMIT 15\r\n"
      ],
      "parameters": [
        {
          "displayName": "Vehicle Prefix",
          "keyword": "p_vehicle_prefix",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "c703d804",
      "displayName": "top_missing_dates_vehicles",
      "queryLines": [
