{
  "datasets": [
    {
      "name": "a11b22c3",
      "displayName": "vehicle_frequency_summary",
      "queryLines": [
        "SELECT\r\n",
        "  MAX(record_created_at) AS latest_refresh_at,\r\n",
        "  COUNT(*) AS vehicles_count,\r\n",
        "  SUM(updates_count) AS total_updates_count,\r\n",
        "  SUM(measured_intervals_count) AS total_measured_intervals_count,\r\n",
        "  CASE\r\n",
        "    WHEN SUM(measured_intervals_count) = 0 THEN NULL\r\n",
        "    ELSE SUM(COALESCE(avg_update_interval_seconds, 0.0) * measured_intervals_count) * 1.0 / SUM(measured_intervals_count)\r\n",
        "  END AS weighted_avg_update_interval_seconds,\r\n",
        "  AVG(stddev_update_interval_seconds) AS avg_vehicle_stddev_interval_seconds,\r\n",
        "  AVG(observed_span_seconds) AS avg_observed_span_seconds\r\n",
        "FROM main.gold.gold_vehicle_update_frequency\r\n",
        "WHERE (\r\n",
        "    :p_vehicle_prefix = 'ALL'\r\n",
        "    OR CAST(vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "  )\r\n"
      ],
      "parameters": [
        {
          "displayName": "Vehicle Prefix",
          "keyword": "p_vehicle_prefix",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "b22c33d4",
      "displayName": "slowest_vehicles",
      "queryLines": [
        "SELECT\r\n",
        "  CAST(vehicle_prefix AS STRING) AS vehicle_prefix,\r\n",
        "  updates_count,\r\n",
        "  measured_intervals_count,\r\n",
        "  avg_update_interval_seconds,\r\n",
        "  min_update_interval_seconds,\r\n",
        "  max_update_interval_seconds,\r\n",
        "  stddev_update_interval_seconds,\r\n",
        "  observed_span_seconds\r\n",
        "FROM main.gold.gold_vehicle_update_frequency\r\n",
        "WHERE (\r\n",
        "    :p_vehicle_prefix = 'ALL'\r\n",
        "    OR CAST(vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "  )\r\n",
        "ORDER BY avg_update_interval_seconds DESC, vehicle_prefix ASC\r\n",
        "LIMIT 15\r\n"
      ],
      "parameters": [
        {
          "displayName": "Vehicle Prefix",
          "keyword": "p_vehicle_prefix",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "c33d44e5",
      "displayName": "fastest_vehicles",
      "queryLines": [
        "SELECT\r\n",
        "  CAST(vehicle_prefix AS STRING) AS vehicle_prefix,\r\n",
        "  updates_count,\r\n",
        "  measured_intervals_count,\r\n",
        "  avg_update_interval_seconds,\r\n",
        "  min_update_interval_seconds,\r\n",
        "  max_update_interval_seconds,\r\n",
        "  stddev_update_interval_seconds,\r\n",
        "  observed_span_seconds\r\n",
        "FROM main.gold.gold_vehicle_update_frequency\r\n",
        "WHERE measured_intervals_count > 0\r\n",
        "  AND (\r\n",
        "    :p_vehicle_prefix = 'ALL'\r\n",
        "    OR CAST(vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "  )\r\n",
        "ORDER BY avg_update_interval_seconds ASC, vehicle_prefix ASC\r\n",
        "LIMIT 15\r\n"
      ],
      "parameters": [
        {
          "displayName": "Vehicle Prefix",
          "keyword": "p_vehicle_prefix",
          "dataType": "STRING",
          "defaultSelection": {
