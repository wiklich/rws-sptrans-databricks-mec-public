        "    RANK() OVER (ORDER BY ((0.4 * COALESCE(update_regularity_score, 0.0)) + (0.3 * COALESCE(continuity_score, 0.0)) + (0.3 * COALESCE(multi_day_score, 0.0))) DESC) AS quality_rank,\r\n",
        "    RANK() OVER (ORDER BY avg_update_interval_seconds ASC) AS update_interval_rank,\r\n",
        "    RANK() OVER (ORDER BY continuity_support_ratio DESC) AS continuity_rank,\r\n",
        "    RANK() OVER (ORDER BY date_presence_ratio DESC) AS multi_day_rank,\r\n",
        "    COUNT(*) OVER () AS total_vehicles_in_population\r\n",
        "  FROM base\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  CAST(vehicle_prefix AS STRING) AS vehicle_prefix,\r\n",
        "  quality_score,\r\n",
        "  quality_rank,\r\n",
        "  update_interval_rank,\r\n",
        "  continuity_rank,\r\n",
        "  multi_day_rank,\r\n",
        "  total_vehicles_in_population\r\n",
        "FROM scored\r\n",
        "WHERE (\r\n",
        "    :p_vehicle_prefix = 'ALL'\r\n",
        "    OR CAST(vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "  )\r\n"
      ],
