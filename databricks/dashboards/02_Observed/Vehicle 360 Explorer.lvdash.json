        "),\r\n",
        "scored AS (\r\n",
        "  SELECT\r\n",
        "    *,\r\n",
        "    ROUND(((0.4 * COALESCE(update_regularity_score, 0.0)) + (0.3 * COALESCE(continuity_score, 0.0)) + (0.3 * COALESCE(multi_day_score, 0.0))) * 100.0, 2) AS quality_score\r\n",
