{
  "datasets": [
    {
      "name": "a360b001",
      "displayName": "vehicle_360_summary",
      "queryLines": [
        "WITH base AS (\r\n",
        "  SELECT\r\n",
        "    uf.vehicle_prefix,\r\n",
        "    uf.updates_count,\r\n",
        "    uf.measured_intervals_count,\r\n",
        "    uf.avg_update_interval_seconds,\r\n",
        "    uf.min_update_interval_seconds,\r\n",
        "    uf.max_update_interval_seconds,\r\n",
        "    uf.stddev_update_interval_seconds,\r\n",
        "    uf.first_captured_at_local AS frequency_first_captured_at_local,\r\n",
        "    uf.last_captured_at_local AS frequency_last_captured_at_local,\r\n",
        "    uf.observed_span_seconds,\r\n",
        "    oc.observations_count,\r\n",
        "    oc.measured_gaps_count,\r\n",
        "    oc.first_captured_at_local AS continuity_first_captured_at_local,\r\n",
        "    oc.last_captured_at_local AS continuity_last_captured_at_local,\r\n",
        "    oc.distinct_minutes_with_data,\r\n",
        "    oc.distinct_hours_with_data,\r\n",
        "    oc.avg_gap_seconds,\r\n",
        "    oc.max_gap_seconds,\r\n",
        "    oc.large_gaps_count,\r\n",
        "    oc.continuity_support_ratio,\r\n",
        "    md.observed_dates_count,\r\n",
        "    md.first_observed_date,\r\n",
        "    md.last_observed_date,\r\n",
        "    md.observed_date_span_days,\r\n",
        "    md.missing_dates_within_span_count,\r\n",
        "    md.date_presence_ratio,\r\n",
        "    md.first_captured_at_local AS multi_day_first_captured_at_local,\r\n",
        "    md.last_captured_at_local AS multi_day_last_captured_at_local,\r\n",
        "    md.total_observations_count,\r\n",
        "    md.avg_observations_per_observed_date,\r\n",
        "    md.max_consecutive_observed_dates,\r\n",
        "    md.max_consecutive_missing_dates_within_span,\r\n",
        "    CASE\r\n",
        "      WHEN uf.avg_update_interval_seconds IS NULL THEN NULL\r\n",
        "      WHEN uf.avg_update_interval_seconds <= 30 THEN 1.0\r\n",
        "      WHEN uf.avg_update_interval_seconds >= 300 THEN 0.0\r\n",
        "      ELSE 1.0 - ((uf.avg_update_interval_seconds - 30.0) / 270.0)\r\n",
        "    END AS update_regularity_score,\r\n",
        "    LEAST(GREATEST(COALESCE(oc.continuity_support_ratio, 0.0), 0.0), 1.0) AS continuity_score,\r\n",
        "    LEAST(GREATEST(COALESCE(md.date_presence_ratio, 0.0), 0.0), 1.0) AS multi_day_score\r\n",
        "  FROM main.gold.gold_vehicle_update_frequency uf\r\n",
        "  INNER JOIN main.gold.gold_vehicle_observation_continuity oc\r\n",
        "    ON uf.vehicle_prefix = oc.vehicle_prefix\r\n",
        "  INNER JOIN main.gold.gold_vehicle_multi_day_continuity md\r\n",
        "    ON uf.vehicle_prefix = md.vehicle_prefix\r\n",
        "),\r\n",
        "scored AS (\r\n",
        "  SELECT\r\n",
        "    *,\r\n",
        "    ROUND(\r\n",
        "      (\r\n",
        "        (0.4 * COALESCE(update_regularity_score, 0.0)) +\r\n",
        "        (0.3 * COALESCE(continuity_score, 0.0)) +\r\n",
        "        (0.3 * COALESCE(multi_day_score, 0.0))\r\n",
        "      ) * 100.0,\r\n",
        "      2\r\n",
        "    ) AS quality_score,\r\n",
        "    CASE\r\n",
        "      WHEN (\r\n",
        "        (0.4 * COALESCE(update_regularity_score, 0.0)) +\r\n",
        "        (0.3 * COALESCE(continuity_score, 0.0)) +\r\n",
        "        (0.3 * COALESCE(multi_day_score, 0.0))\r\n",
        "      ) * 100.0 >= 80 THEN 'Elite'\r\n",
        "      WHEN (\r\n",
        "        (0.4 * COALESCE(update_regularity_score, 0.0)) +\r\n",
        "        (0.3 * COALESCE(continuity_score, 0.0)) +\r\n",
        "        (0.3 * COALESCE(multi_day_score, 0.0))\r\n",
        "      ) * 100.0 >= 60 THEN 'Healthy'\r\n",
        "      WHEN (\r\n",
        "        (0.4 * COALESCE(update_regularity_score, 0.0)) +\r\n",
        "        (0.3 * COALESCE(continuity_score, 0.0)) +\r\n",
        "        (0.3 * COALESCE(multi_day_score, 0.0))\r\n",
        "      ) * 100.0 >= 40 THEN 'Watchlist'\r\n",
        "      ELSE 'Critical'\r\n",
        "    END AS quality_segment\r\n",
        "  FROM base\r\n",
        "),\r\n",
        "aggregated AS (\r\n",
        "  SELECT\r\n",
        "    AVG(quality_score) AS quality_score,\r\n",
        "    AVG(avg_update_interval_seconds) AS avg_update_interval_seconds,\r\n",
        "    AVG(continuity_support_ratio) AS continuity_support_ratio,\r\n",
        "    AVG(date_presence_ratio) AS date_presence_ratio,\r\n",
        "    AVG(observed_dates_count) AS observed_dates_count,\r\n",
        "    AVG(large_gaps_count) AS large_gaps_count,\r\n",
        "    AVG(missing_dates_within_span_count) AS missing_dates_within_span_count,\r\n",
        "    AVG(max_gap_seconds) AS max_gap_seconds,\r\n",
        "    AVG(max_consecutive_observed_dates) AS max_consecutive_observed_dates,\r\n",
        "    AVG(max_consecutive_missing_dates_within_span) AS max_consecutive_missing_dates_within_span\r\n",
        "  FROM scored\r\n",
        "  WHERE (\r\n",
        "    :p_vehicle_prefix = 'ALL'\r\n",
        "    OR CAST(vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "  )\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  CASE\r\n",
        "    WHEN :p_vehicle_prefix = 'ALL' THEN 'Fleet Average'\r\n",
        "    ELSE :p_vehicle_prefix\r\n",
        "  END AS entity_label,\r\n",
        "  quality_score,\r\n",
        "  avg_update_interval_seconds,\r\n",
        "  continuity_support_ratio,\r\n",
        "  date_presence_ratio,\r\n",
        "  observed_dates_count,\r\n",
        "  large_gaps_count,\r\n",
        "  missing_dates_within_span_count,\r\n",
        "  max_gap_seconds,\r\n",
        "  max_consecutive_observed_dates,\r\n",
        "  max_consecutive_missing_dates_within_span\r\n",
        "FROM aggregated"
      ],
      "parameters": [
        {
          "displayName": "Vehicle Prefix",
          "keyword": "p_vehicle_prefix",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    },
    {
