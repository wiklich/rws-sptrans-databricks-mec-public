        "    quality_score AS metric_value\r\n",
        "  FROM scored\r\n",
        "  WHERE CAST(vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "  UNION ALL\r\n",
        "  SELECT 'Selected Vehicle', 'Avg Update Interval (Sec)', avg_update_interval_seconds FROM scored WHERE CAST(vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "  UNION ALL\r\n",
        "  SELECT 'Selected Vehicle', 'Continuity Support Ratio', continuity_support_ratio FROM scored WHERE CAST(vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "  UNION ALL\r\n",
        "  SELECT 'Selected Vehicle', 'Date Presence Ratio', date_presence_ratio FROM scored WHERE CAST(vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "),\r\n",
        "fleet_avg AS (\r\n",
        "  SELECT 'Fleet Average' AS benchmark_group, 'Quality Score' AS metric_name, AVG(quality_score) AS metric_value FROM scored\r\n",
        "  UNION ALL\r\n",
        "  SELECT 'Fleet Average', 'Avg Update Interval (Sec)', AVG(avg_update_interval_seconds) FROM scored\r\n",
        "  UNION ALL\r\n",
        "  SELECT 'Fleet Average', 'Continuity Support Ratio', AVG(continuity_support_ratio) FROM scored\r\n",
        "  UNION ALL\r\n",
        "  SELECT 'Fleet Average', 'Date Presence Ratio', AVG(date_presence_ratio) FROM scored\r\n",
        ")\r\n",
        "SELECT *\r\n",
        "FROM fleet_avg\r\n",
        "UNION ALL\r\n",
        "SELECT *\r\n",
        "FROM selected_vehicle\r\n"
      ],
      "parameters": [
