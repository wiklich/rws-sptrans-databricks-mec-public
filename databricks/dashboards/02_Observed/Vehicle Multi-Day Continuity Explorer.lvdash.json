    {
      "name": "f26g37h8",
      "displayName": "vehicle_prefix_options",
      "queryLines": [
        "SELECT\r\n",
        "  vehicle_prefix\r\n",
        "FROM (\r\n",
        "  SELECT 'ALL' AS vehicle_prefix, 0 AS sort_order\r\n",
        "  UNION ALL\r\n",
        "  SELECT DISTINCT CAST(vehicle_prefix AS STRING) AS vehicle_prefix, 1 AS sort_order\r\n",
        "  FROM main.gold.gold_vehicle_multi_day_continuity\r\n",
        "  WHERE vehicle_prefix IS NOT NULL\r\n",
        ") options\r\n",
        "ORDER BY sort_order, vehicle_prefix\r\n"
      ]
    }
  ],
