{
  "datasets": [
    {
      "name": "a71b82c3",
      "displayName": "vehicle_multi_day_summary",
      "queryLines": [
        "SELECT\r\n",
        "  MAX(record_created_at) AS latest_refresh_at,\r\n",
        "  COUNT(*) AS vehicles_count,\r\n",
        "  AVG(observed_dates_count) AS avg_observed_dates_count,\r\n",
        "  AVG(observed_date_span_days) AS avg_observed_date_span_days,\r\n",
        "  AVG(missing_dates_within_span_count) AS avg_missing_dates_within_span_count,\r\n",
        "  AVG(date_presence_ratio) AS avg_date_presence_ratio,\r\n",
        "  SUM(total_observations_count) AS total_observations_count,\r\n",
        "  AVG(avg_observations_per_observed_date) AS avg_observations_per_observed_date,\r\n",
        "  AVG(max_consecutive_observed_dates) AS avg_max_consecutive_observed_dates,\r\n",
        "  AVG(max_consecutive_missing_dates_within_span) AS avg_max_consecutive_missing_dates_within_span\r\n",
        "FROM main.gold.gold_vehicle_multi_day_continuity\r\n",
        "WHERE (\r\n",
        "    :p_vehicle_prefix = 'ALL'\r\n",
        "    OR CAST(vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "  )\r\n"
      ],
      "parameters": [
        {
          "displayName": "Vehicle Prefix",
          "keyword": "p_vehicle_prefix",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "b82c93d4",
      "displayName": "most_fragmented_multi_day_vehicles",
      "queryLines": [
        "SELECT\r\n",
        "  CAST(vehicle_prefix AS STRING) AS vehicle_prefix,\r\n",
        "  observed_dates_count,\r\n",
        "  observed_date_span_days,\r\n",
        "  missing_dates_within_span_count,\r\n",
        "  date_presence_ratio,\r\n",
        "  total_observations_count,\r\n",
        "  avg_observations_per_observed_date,\r\n",
        "  max_consecutive_observed_dates,\r\n",
        "  max_consecutive_missing_dates_within_span\r\n",
        "FROM main.gold.gold_vehicle_multi_day_continuity\r\n",
        "WHERE (\r\n",
        "    :p_vehicle_prefix = 'ALL'\r\n",
        "    OR CAST(vehicle_prefix AS STRING) = :p_vehicle_prefix\r\n",
        "  )\r\n",
        "ORDER BY date_presence_ratio ASC, missing_dates_within_span_count DESC, vehicle_prefix ASC\r\n",
        "LIMIT 15\r\n"
      ],
      "parameters": [
        {
          "displayName": "Vehicle Prefix",
          "keyword": "p_vehicle_prefix",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    },
