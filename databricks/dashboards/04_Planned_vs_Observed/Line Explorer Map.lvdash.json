{
  "datasets": [
    {
      "name": "1a2b3c4d",
      "displayName": "line_options",
      "queryLines": [
        "SELECT\r\n",
        "  line_sign\r\n",
        "FROM (\r\n",
        "  SELECT 'ALL' AS line_sign, 0 AS sort_order\r\n",
        "  UNION ALL\r\n",
        "  SELECT DISTINCT line_sign AS line_sign, 1 AS sort_order\r\n",
        "  FROM main.gold.gold_planned_vs_observed_service_adherence_hourly\r\n",
        "  WHERE (\r\n",
        "      :p_service_date_range.min IS NULL\r\n",
        "      OR :p_service_date_range.max IS NULL\r\n",
        "      OR service_date BETWEEN CAST(:p_service_date_range.min AS DATE)\r\n",
        "                          AND CAST(:p_service_date_range.max AS DATE)\r\n",
        "    )\r\n",
        "    AND line_sign IS NOT NULL\r\n",
        "    AND TRIM(line_sign) <> ''\r\n",
        ") options\r\n",
        "ORDER BY sort_order, line_sign\r\n"
      ],
      "parameters": [
        {
          "displayName": "Service Date Range",
          "keyword": "p_service_date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE"
            }
          }
        }
      ]
    },
    {
      "name": "2b3c4d5e",
      "displayName": "direction_options",
      "queryLines": [
        "SELECT\r\n",
        "  gtfs_direction_id\r\n",
        "FROM (\r\n",
        "  SELECT 'ALL' AS gtfs_direction_id, 0 AS sort_order\r\n",
        "  UNION ALL\r\n",
        "  SELECT DISTINCT CAST(gtfs_direction_id AS STRING) AS gtfs_direction_id, 1 AS sort_order\r\n",
        "  FROM main.gold.gold_planned_vs_observed_service_adherence_hourly\r\n",
        "  WHERE gtfs_direction_id IS NOT NULL\r\n",
        ") options\r\n",
        "ORDER BY sort_order, gtfs_direction_id\r\n"
      ]
    },
    {
      "name": "3c4d5e6f",
      "displayName": "hour_options",
      "queryLines": [
        "SELECT\r\n",
        "  hour\r\n",
        "FROM (\r\n",
        "  SELECT 'ALL' AS hour, 0 AS sort_order\r\n",
        "  UNION ALL\r\n",
        "  SELECT DISTINCT CAST(hour AS STRING) AS hour, 1 AS sort_order\r\n",
        "  FROM main.gold.gold_planned_vs_observed_service_adherence_hourly\r\n",
        "  WHERE hour IS NOT NULL\r\n",
        ") options\r\n",
        "ORDER BY sort_order, hour\r\n"
      ]
    },
    {
      "name": "4d5e6f70",
      "displayName": "line_summary",
      "queryLines": [
        "SELECT\r\n",
        "  MAX(service_date) AS latest_service_date,\r\n",
        "  SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END) AS planned_service_hours,\r\n",
        "  SUM(CASE WHEN observed_service_present_flag THEN 1 ELSE 0 END) AS observed_service_hours,\r\n",
        "  SUM(CASE WHEN missed_service_flag THEN 1 ELSE 0 END) AS missed_service_windows,\r\n",
        "  AVG(planned_headway_minutes) AS avg_planned_headway_minutes,\r\n",
        "  AVG(observed_headway_avg_minutes) AS avg_observed_headway_avg_minutes,\r\n",
        "  AVG(headway_deviation_minutes) AS avg_headway_deviation_minutes\r\n",
        "FROM main.gold.gold_planned_vs_observed_service_adherence_hourly\r\n",
        "WHERE (\r\n",
        "    :p_line_sign = 'ALL'\r\n",
        "    OR line_sign = :p_line_sign\r\n",
        "  )\r\n",
        "  AND (\r\n",
        "    :p_gtfs_direction_id = 'ALL'\r\n",
        "    OR CAST(gtfs_direction_id AS STRING) = :p_gtfs_direction_id\r\n",
        "  )\r\n",
        "  AND (\r\n",
        "    :p_service_date_range.min IS NULL\r\n",
        "    OR :p_service_date_range.max IS NULL\r\n",
        "    OR service_date BETWEEN CAST(:p_service_date_range.min AS DATE)\r\n",
        "                        AND CAST(:p_service_date_range.max AS DATE)\r\n",
        "  )\r\n"
      ],
      "parameters": [
        {
          "displayName": "Line Sign",
          "keyword": "p_line_sign",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        },
        {
          "displayName": "GTFS Direction",
          "keyword": "p_gtfs_direction_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        },
        {
          "displayName": "Service Date Range",
          "keyword": "p_service_date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE"
            }
          }
        }
      ]
    },
    {
      "name": "5e6f7081",
      "displayName": "line_hourly_profile",
      "queryLines": [
        "SELECT\r\n",
        "  hour,\r\n",
        "  AVG(planned_headway_minutes) AS avg_planned_headway_minutes,\r\n",
        "  AVG(observed_headway_avg_minutes) AS avg_observed_headway_avg_minutes,\r\n",
        "  AVG(headway_deviation_minutes) AS avg_headway_deviation_minutes,\r\n",
        "  AVG(headway_deviation_pct) AS avg_headway_deviation_pct,\r\n",
        "  SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END) AS planned_service_hours,\r\n",
        "  SUM(CASE WHEN observed_service_present_flag THEN 1 ELSE 0 END) AS observed_service_hours,\r\n",
        "  SUM(CASE WHEN missed_service_flag THEN 1 ELSE 0 END) AS missed_service_windows\r\n",
        "FROM main.gold.gold_planned_vs_observed_service_adherence_hourly\r\n",
        "WHERE (\r\n",
        "    :p_line_sign = 'ALL'\r\n",
        "    OR line_sign = :p_line_sign\r\n",
        "  )\r\n",
        "  AND (\r\n",
        "    :p_gtfs_direction_id = 'ALL'\r\n",
        "    OR CAST(gtfs_direction_id AS STRING) = :p_gtfs_direction_id\r\n",
        "  )\r\n",
        "  AND (\r\n",
        "    :p_service_date_range.min IS NULL\r\n",
        "    OR :p_service_date_range.max IS NULL\r\n",
        "    OR service_date BETWEEN CAST(:p_service_date_range.min AS DATE)\r\n",
        "                        AND CAST(:p_service_date_range.max AS DATE)\r\n",
        "  )\r\n",
        "GROUP BY hour\r\n",
        "ORDER BY hour ASC\r\n"
      ],
      "parameters": [
        {
          "displayName": "Line Sign",
          "keyword": "p_line_sign",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        },
        {
          "displayName": "GTFS Direction",
          "keyword": "p_gtfs_direction_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        },
        {
          "displayName": "Service Date Range",
          "keyword": "p_service_date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE"
            }
          }
        }
      ]
    },
    {
      "name": "6f708192",
      "displayName": "line_map_points",
      "queryLines": [
        "SELECT\r\n",
        "  service_date,\r\n",
        "  captured_at_local,\r\n",
        "  hour,\r\n",
        "  line_sign,\r\n",
        "  gtfs_direction_id,\r\n",
        "  observed_direction,\r\n",
        "  direction_description,\r\n",
        "  CAST(vehicle_prefix AS STRING) AS vehicle_prefix,\r\n",
        "  latitude,\r\n",
        "  longitude,\r\n",
        "  planned_headway_minutes,\r\n",
        "  observed_headway_avg_minutes,\r\n",
        "  headway_deviation_minutes,\r\n",
        "  headway_deviation_pct,\r\n",
        "  missed_service_flag,\r\n",
        "  adherence_band\r\n",
        "FROM main.gold.gold_line_explorer_map_points\r\n",
        "WHERE (\r\n",
        "    :p_line_sign = 'ALL'\r\n",
        "    OR line_sign = :p_line_sign\r\n",
        "  )\r\n",
        "  AND (\r\n",
        "    :p_gtfs_direction_id = 'ALL'\r\n",
        "    OR CAST(gtfs_direction_id AS STRING) = :p_gtfs_direction_id\r\n",
        "  )\r\n",
        "  AND (\r\n",
        "    :p_hour = 'ALL'\r\n",
        "    OR CAST(hour AS STRING) = :p_hour\r\n",
        "  )\r\n",
        "  AND (\r\n",
        "    :p_service_date_range.min IS NULL\r\n",
