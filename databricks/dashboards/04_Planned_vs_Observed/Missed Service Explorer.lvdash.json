{
  "datasets": [
    {
      "name": "aa11bb22",
      "displayName": "missed_service_summary",
      "queryLines": [
        "SELECT\r\n",
        "  MAX(service_date) AS latest_service_date,\r\n",
        "  COUNT(*) AS missed_service_windows,\r\n",
        "  COUNT(DISTINCT service_date) AS affected_service_days,\r\n",
        "  COUNT(DISTINCT line_sign) AS affected_lines,\r\n",
        "  AVG(planned_headway_minutes) AS avg_planned_headway_minutes,\r\n",
        "  AVG(hour) AS avg_hour_of_missed_service\r\n",
        "FROM main.gold.gold_planned_vs_observed_service_adherence_hourly\r\n",
        "WHERE missed_service_flag = TRUE\r\n",
        "  AND (\r\n",
        "    :p_service_date_range.min IS NULL\r\n",
        "    OR :p_service_date_range.max IS NULL\r\n",
        "    OR service_date BETWEEN CAST(:p_service_date_range.min AS DATE)\r\n",
        "                        AND CAST(:p_service_date_range.max AS DATE)\r\n",
        "  )\r\n",
        "  AND (\r\n",
        "    :p_gtfs_direction_id = 'ALL'\r\n",
        "    OR CAST(gtfs_direction_id AS STRING) = :p_gtfs_direction_id\r\n",
        "  )\r\n",
        "  AND (\r\n",
        "    :p_line_sign = 'ALL'\r\n",
        "    OR line_sign = :p_line_sign\r\n",
        "  )\r\n"
      ],
      "parameters": [
        {
          "displayName": "Service Date Range",
          "keyword": "p_service_date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "2026-03-18T00:00:00.000"
              },
              "max": {
                "value": "2026-03-18T00:00:00.000"
              }
            }
          }
        },
        {
          "displayName": "GTFS Direction",
          "keyword": "p_gtfs_direction_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        },
        {
          "displayName": "Line Sign",
          "keyword": "p_line_sign",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    },
