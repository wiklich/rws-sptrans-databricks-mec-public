{
  "datasets": [
    {
      "name": "a11b22c3",
      "displayName": "line_options",
      "queryLines": [
        "SELECT\r\n",
        "  line_sign\r\n",
        "FROM (\r\n",
        "  SELECT 'ALL' AS line_sign, 0 AS sort_order\r\n",
        "  UNION ALL\r\n",
        "  SELECT DISTINCT line_sign AS line_sign, 1 AS sort_order\r\n",
        "  FROM main.gold.gold_route_geometry_reference\r\n",
        "  WHERE line_sign IS NOT NULL\r\n",
        "    AND TRIM(line_sign) <> ''\r\n",
        ") options\r\n",
        "ORDER BY sort_order, line_sign\r\n"
      ]
    },
    {
      "name": "b22c33d4",
      "displayName": "direction_options",
      "queryLines": [
        "SELECT\r\n",
        "  gtfs_direction_id\r\n",
        "FROM (\r\n",
        "  SELECT 'ALL' AS gtfs_direction_id, 0 AS sort_order\r\n",
        "  UNION ALL\r\n",
        "  SELECT DISTINCT CAST(gtfs_direction_id AS STRING) AS gtfs_direction_id, 1 AS sort_order\r\n",
        "  FROM main.gold.gold_route_geometry_reference\r\n",
        "  WHERE gtfs_direction_id IS NOT NULL\r\n",
        ") options\r\n",
        "ORDER BY sort_order, gtfs_direction_id\r\n"
      ]
    },
    {
      "name": "c33d44e5",
      "displayName": "route_adherence_summary",
      "queryLines": [
        "WITH base AS (\r\n",
        "  SELECT\r\n",
        "    service_date,\r\n",
        "    line_sign,\r\n",
        "    gtfs_direction_id,\r\n",
        "    planned_service_present_flag,\r\n",
        "    missed_service_flag,\r\n",
        "    planned_headway_minutes,\r\n",
        "    observed_headway_avg_minutes,\r\n",
        "    headway_deviation_minutes\r\n",
        "  FROM main.gold.gold_planned_vs_observed_service_adherence_hourly\r\n",
        "  WHERE (\r\n",
        "      :p_service_date_range.min IS NULL\r\n",
        "      OR :p_service_date_range.max IS NULL\r\n",
        "      OR service_date BETWEEN CAST(:p_service_date_range.min AS DATE)\r\n",
        "                          AND CAST(:p_service_date_range.max AS DATE)\r\n",
        "    )\r\n",
        "    AND (\r\n",
        "      :p_line_sign = 'ALL'\r\n",
        "      OR line_sign = :p_line_sign\r\n",
        "    )\r\n",
        "    AND (\r\n",
        "      :p_gtfs_direction_id = 'ALL'\r\n",
        "      OR CAST(gtfs_direction_id AS STRING) = :p_gtfs_direction_id\r\n",
        "    )\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  MAX(service_date) AS latest_service_date,\r\n",
        "  COUNT(DISTINCT CONCAT_WS('||', line_sign, CAST(gtfs_direction_id AS STRING))) AS route_direction_count,\r\n",
        "  SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END) AS planned_service_hours,\r\n",
        "  SUM(CASE WHEN missed_service_flag THEN 1 ELSE 0 END) AS missed_service_windows,\r\n",
        "  CASE\r\n",
        "    WHEN SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END) = 0 THEN NULL\r\n",
        "    ELSE SUM(CASE WHEN missed_service_flag THEN 1 ELSE 0 END) * 1.0\r\n",
        "         / SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END)\r\n",
        "  END AS missed_service_rate,\r\n",
        "  AVG(planned_headway_minutes) AS avg_planned_headway_minutes,\r\n",
        "  AVG(observed_headway_avg_minutes) AS avg_observed_headway_avg_minutes,\r\n",
        "  AVG(headway_deviation_minutes) AS avg_headway_deviation_minutes\r\n",
        "FROM base\r\n"
      ],
      "parameters": [
        {
          "displayName": "Service Date Range",
          "keyword": "p_service_date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE"
            }
          }
        },
        {
          "displayName": "Line Sign",
          "keyword": "p_line_sign",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        },
        {
          "displayName": "GTFS Direction",
          "keyword": "p_gtfs_direction_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "d44e55f6",
      "displayName": "route_adherence_map_points",
      "queryLines": [
        "WITH adherence AS (\r\n",
        "  SELECT\r\n",
        "    line_sign,\r\n",
        "    gtfs_direction_id,\r\n",
        "    SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END) AS planned_service_hours,\r\n",
        "    SUM(CASE WHEN observed_service_present_flag THEN 1 ELSE 0 END) AS observed_service_hours,\r\n",
        "    SUM(CASE WHEN missed_service_flag THEN 1 ELSE 0 END) AS missed_service_windows,\r\n",
        "    CASE\r\n",
        "      WHEN SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END) = 0 THEN NULL\r\n",
        "      ELSE SUM(CASE WHEN missed_service_flag THEN 1 ELSE 0 END) * 1.0\r\n",
        "           / SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END)\r\n",
        "    END AS missed_service_rate,\r\n",
        "    AVG(planned_headway_minutes) AS avg_planned_headway_minutes,\r\n",
        "    AVG(observed_headway_avg_minutes) AS avg_observed_headway_avg_minutes,\r\n",
        "    AVG(headway_deviation_minutes) AS avg_headway_deviation_minutes,\r\n",
        "    AVG(headway_deviation_pct) AS avg_headway_deviation_pct\r\n",
        "  FROM main.gold.gold_planned_vs_observed_service_adherence_hourly\r\n",
        "  WHERE (\r\n",
        "      :p_service_date_range.min IS NULL\r\n",
        "      OR :p_service_date_range.max IS NULL\r\n",
        "      OR service_date BETWEEN CAST(:p_service_date_range.min AS DATE)\r\n",
        "                          AND CAST(:p_service_date_range.max AS DATE)\r\n",
        "    )\r\n",
        "    AND (\r\n",
        "      :p_line_sign = 'ALL'\r\n",
        "      OR line_sign = :p_line_sign\r\n",
        "    )\r\n",
        "    AND (\r\n",
        "      :p_gtfs_direction_id = 'ALL'\r\n",
        "      OR CAST(gtfs_direction_id AS STRING) = :p_gtfs_direction_id\r\n",
        "    )\r\n",
        "  GROUP BY line_sign, gtfs_direction_id\r\n",
        "  HAVING SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END) > 0\r\n",
        "),\r\n",
        "geometry_points AS (\r\n",
        "  SELECT\r\n",
        "    g.line_sign,\r\n",
        "    g.route_id,\r\n",
        "    g.route_long_name,\r\n",
        "    g.route_name_display,\r\n",
        "    g.gtfs_direction_id,\r\n",
        "    g.direction_description,\r\n",
        "    g.trip_headsign_reference,\r\n",
        "    g.representative_shape_id,\r\n",
        "    g.geometry_point_count,\r\n",
        "    h.shape_pt_sequence,\r\n",
        "    h.shape_pt_lat AS latitude,\r\n",
        "    h.shape_pt_lon AS longitude\r\n",
        "  FROM main.gold.gold_route_geometry_reference g\r\n",
        "  INNER JOIN main.silver.silver_helper_route_shape_points_reference h\r\n",
        "    ON g.line_sign = h.line_sign\r\n",
        "   AND g.gtfs_direction_id = h.gtfs_direction_id\r\n",
        "   AND g.representative_shape_id = h.shape_id\r\n",
        "   AND g.gtfs_load_date = h.gtfs_load_date\r\n",
        "  WHERE (\r\n",
        "      :p_line_sign = 'ALL'\r\n",
        "      OR g.line_sign = :p_line_sign\r\n",
        "    )\r\n",
        "    AND (\r\n",
        "      :p_gtfs_direction_id = 'ALL'\r\n",
        "      OR CAST(g.gtfs_direction_id AS STRING) = :p_gtfs_direction_id\r\n",
        "    )\r\n",
        "    AND (\r\n",
        "      h.shape_pt_sequence = 1\r\n",
        "      OR h.shape_pt_sequence = h.shape_point_count\r\n",
        "      OR MOD(h.shape_pt_sequence, 5) = 0\r\n",
        "    )\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  gp.latitude,\r\n",
        "  gp.longitude,\r\n",
        "  gp.line_sign,\r\n",
        "  gp.route_id,\r\n",
        "  gp.route_long_name,\r\n",
        "  gp.route_name_display,\r\n",
        "  gp.gtfs_direction_id,\r\n",
        "  gp.direction_description,\r\n",
        "  gp.trip_headsign_reference,\r\n",
        "  gp.representative_shape_id,\r\n",
        "  gp.geometry_point_count,\r\n",
        "  gp.shape_pt_sequence,\r\n",
        "  a.planned_service_hours,\r\n",
        "  a.observed_service_hours,\r\n",
        "  a.missed_service_windows,\r\n",
        "  a.missed_service_rate,\r\n",
        "  a.avg_planned_headway_minutes,\r\n",
        "  a.avg_observed_headway_avg_minutes,\r\n",
        "  a.avg_headway_deviation_minutes,\r\n",
        "  a.avg_headway_deviation_pct,\r\n",
        "  CASE\r\n",
        "    WHEN COALESCE(a.missed_service_rate, 0) >= 0.40 OR COALESCE(a.avg_headway_deviation_minutes, 0) >= 10 THEN 'High'\r\n",
        "    WHEN COALESCE(a.missed_service_rate, 0) >= 0.15 OR COALESCE(a.avg_headway_deviation_minutes, 0) >= 3 THEN 'Moderate'\r\n",
        "    ELSE 'Low'\r\n",
        "  END AS adherence_band\r\n",
        "FROM geometry_points gp\r\n",
        "INNER JOIN adherence a\r\n",
        "  ON gp.line_sign = a.line_sign\r\n",
        " AND gp.gtfs_direction_id = a.gtfs_direction_id\r\n",
        "ORDER BY gp.line_sign ASC, gp.gtfs_direction_id ASC, gp.shape_pt_sequence ASC\r\n"
      ],
      "parameters": [
        {
          "displayName": "Service Date Range",
          "keyword": "p_service_date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE"
            }
          }
        },
        {
          "displayName": "Line Sign",
          "keyword": "p_line_sign",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        },
        {
          "displayName": "GTFS Direction",
          "keyword": "p_gtfs_direction_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "e55f6677",
      "displayName": "route_adherence_route_table",
      "queryLines": [
        "WITH adherence AS (\r\n",
        "  SELECT\r\n",
        "    line_sign,\r\n",
        "    gtfs_direction_id,\r\n",
        "    SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END) AS planned_service_hours,\r\n",
        "    SUM(CASE WHEN observed_service_present_flag THEN 1 ELSE 0 END) AS observed_service_hours,\r\n",
        "    SUM(CASE WHEN missed_service_flag THEN 1 ELSE 0 END) AS missed_service_windows,\r\n",
        "    CASE\r\n",
        "      WHEN SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END) = 0 THEN NULL\r\n",
        "      ELSE SUM(CASE WHEN missed_service_flag THEN 1 ELSE 0 END) * 1.0\r\n",
        "           / SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END)\r\n",
        "    END AS missed_service_rate,\r\n",
        "    AVG(planned_headway_minutes) AS avg_planned_headway_minutes,\r\n",
        "    AVG(observed_headway_avg_minutes) AS avg_observed_headway_avg_minutes,\r\n",
        "    AVG(headway_deviation_minutes) AS avg_headway_deviation_minutes,\r\n",
        "    AVG(headway_deviation_pct) AS avg_headway_deviation_pct\r\n",
        "  FROM main.gold.gold_planned_vs_observed_service_adherence_hourly\r\n",
        "  WHERE (\r\n",
        "      :p_service_date_range.min IS NULL\r\n",
        "      OR :p_service_date_range.max IS NULL\r\n",
        "      OR service_date BETWEEN CAST(:p_service_date_range.min AS DATE)\r\n",
        "                          AND CAST(:p_service_date_range.max AS DATE)\r\n",
        "    )\r\n",
        "    AND (\r\n",
        "      :p_line_sign = 'ALL'\r\n",
        "      OR line_sign = :p_line_sign\r\n",
        "    )\r\n",
        "    AND (\r\n",
        "      :p_gtfs_direction_id = 'ALL'\r\n",
        "      OR CAST(gtfs_direction_id AS STRING) = :p_gtfs_direction_id\r\n",
        "    )\r\n",
        "  GROUP BY line_sign, gtfs_direction_id\r\n",
        "  HAVING SUM(CASE WHEN planned_service_present_flag THEN 1 ELSE 0 END) > 0\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  g.line_sign,\r\n",
        "  g.route_id,\r\n",
        "  g.route_long_name,\r\n",
        "  g.route_name_display,\r\n",
        "  g.gtfs_direction_id,\r\n",
        "  g.direction_description,\r\n",
        "  g.trip_headsign_reference,\r\n",
        "  g.representative_shape_id,\r\n",
        "  g.geometry_point_count,\r\n",
        "  a.planned_service_hours,\r\n",
        "  a.observed_service_hours,\r\n",
        "  a.missed_service_windows,\r\n",
        "  a.missed_service_rate,\r\n",
        "  a.avg_planned_headway_minutes,\r\n",
        "  a.avg_observed_headway_avg_minutes,\r\n",
        "  a.avg_headway_deviation_minutes,\r\n",
        "  a.avg_headway_deviation_pct,\r\n",
        "  CASE\r\n",
        "    WHEN COALESCE(a.missed_service_rate, 0) >= 0.40 OR COALESCE(a.avg_headway_deviation_minutes, 0) >= 10 THEN 'High'\r\n",
        "    WHEN COALESCE(a.missed_service_rate, 0) >= 0.15 OR COALESCE(a.avg_headway_deviation_minutes, 0) >= 3 THEN 'Moderate'\r\n",
        "    ELSE 'Low'\r\n",
        "  END AS adherence_band\r\n",
        "FROM main.gold.gold_route_geometry_reference g\r\n",
        "INNER JOIN adherence a\r\n",
        "  ON g.line_sign = a.line_sign\r\n",
        " AND g.gtfs_direction_id = a.gtfs_direction_id\r\n",
        "WHERE (\r\n",
        "    :p_line_sign = 'ALL'\r\n",
        "    OR g.line_sign = :p_line_sign\r\n",
        "  )\r\n",
        "  AND (\r\n",
        "    :p_gtfs_direction_id = 'ALL'\r\n",
        "    OR CAST(g.gtfs_direction_id AS STRING) = :p_gtfs_direction_id\r\n",
        "  )\r\n",
        "ORDER BY a.missed_service_rate DESC NULLS LAST,\r\n",
        "         a.avg_headway_deviation_minutes DESC NULLS LAST,\r\n",
        "         g.line_sign ASC,\r\n",
        "         g.gtfs_direction_id ASC\r\n",
        "LIMIT 250\r\n"
      ],
      "parameters": [
        {
          "displayName": "Service Date Range",
          "keyword": "p_service_date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE"
            }
          }
        },
        {
          "displayName": "Line Sign",
          "keyword": "p_line_sign",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        },
        {
          "displayName": "GTFS Direction",
          "keyword": "p_gtfs_direction_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "ALL"
                }
              ]
            }
          }
        }
      ]
    }
